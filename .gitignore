# ---------- Private research ----------
# Analysis of the prior app and its raw artifacts. Kept locally, never published.
docs/

# ---------- CI, pending token scope ----------
# Pushing these needs a token with the `workflow` scope. Until then they are
# kept out of commits so a `git add -A` cannot break the push:
#   gh auth refresh -s workflow
#   git add -f .github/workflows && git commit && git push
.github/workflows/

# ---------- Deployment secrets ----------
deploy/*.pem
deploy/.env
deploy/.admin-token
*.pem
