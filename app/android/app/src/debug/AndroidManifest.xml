<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Debug builds talk to a local backend over plain HTTP. Android 9+ blocks
         cleartext by default; this override is scoped to the debug variant so
         release builds keep the strict default. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <application android:usesCleartextTraffic="true" />
</manifest>
