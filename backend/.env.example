# Copy to .env and adjust. All variables are prefixed OPEN_ROUTINE_.

# SQLite by default; no server needed.
OPEN_ROUTINE_DATABASE_URL=sqlite+aiosqlite:///./open_routine.db
# Postgres alternative (requires: pip install -e ".[postgres]")
# OPEN_ROUTINE_DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/open_routine

OPEN_ROUTINE_ENVIRONMENT=development
OPEN_ROUTINE_LOG_LEVEL=INFO

# Comma-separated. Use explicit origins in production, never "*".
OPEN_ROUTINE_CORS_ORIGINS=*

# Token required by write endpoints (routine ingestion). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
OPEN_ROUTINE_ADMIN_TOKEN=
